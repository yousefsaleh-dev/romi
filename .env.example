NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Set the one admin user's email. Disable public sign-ups in Supabase Auth.
ADMIN_EMAIL=

# Server-only values used by the API and the ESP32 request guard.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
ROMI_DEVICE_TOKEN=

# Current Gemini 3.8 Live list rates per 1M tokens (verify before a real deployment).
GEMINI_BILLING_TIER=paid
GEMINI_TEXT_INPUT_USD_PER_MILLION=0.75
GEMINI_TEXT_OUTPUT_USD_PER_MILLION=4.50
GEMINI_AUDIO_INPUT_USD_PER_MILLION=3.00
GEMINI_AUDIO_OUTPUT_USD_PER_MILLION=12.00
